# ---------------------------------------------------------------
# 评论后端配置（不设置则使用 local 本地演示模式）
# ---------------------------------------------------------------

# 可选值：local | waline | twikoo
VITE_COMMENT_PROVIDER=local

# Waline 服务端地址（provider=waline 时必填）
# 例：https://your-waline.vercel.app
VITE_WALINE_SERVER_URL=

# Twikoo 云函数地址（provider=twikoo 时必填）
# 例：https://your-twikoo.vercel.app
VITE_TWIKOO_ENV_ID=

# 本地演示模式的管理员密码（仅 provider=local 时生效）
# 注意：该密码在浏览器端比对，仅用于功能演示，切勿用于生产环境
VITE_LOCAL_ADMIN_PASSWORD=hitwh-admin
